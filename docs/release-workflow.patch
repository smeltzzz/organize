# Unapplied CI change: .github/workflows/release.yml (new file)
#
# Same reason as ci-workflow.patch - the Arena GitHub App that pushes this
# branch has no `workflows` permission, so a commit that adds a workflow file
# is rejected outright. Apply it with a token that has one:
#
#     git apply docs/release-workflow.patch && git add .github && git commit
#
# It publishes to PyPI from a pushed tag (`v3.6.0`) using Trusted Publishing,
# so there is no API token in the repository secrets. Before the first release,
# register the publisher once at
# https://pypi.org/manage/project/organizekit/settings/publishing/ with owner
# `smeltzzz`, repository `organize`, workflow `release.yml`, environment
# `pypi`. The distribution is `organizekit` because `organize` on PyPI has been
# taken since 2011; the console script it installs is still `organize`.
#
# The job order is the point: the offline suite runs before anything is built,
# the tag is checked against organizekit.VERSION, the wheel is installed into a
# clean venv and run from outside the source tree, and the sdist's own test
# suite is executed - because a version on PyPI is immutable and a broken one
# can only be answered with another release.
#
# Verified with `git apply --check` against the tip of this branch.

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..778c7f1
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,120 @@
+# Publish a release to PyPI, from a tag, with nothing to type and no token to
+# leak.
+#
+# The trigger is a pushed tag (`v3.6.0`). The job re-runs the full offline
+# suite before it builds anything, because a release is the one artifact nobody
+# can quietly fix afterwards: a version on PyPI is immutable, and a broken
+# 3.6.0 can only be answered with 3.6.1.
+#
+# Authentication is PyPI Trusted Publishing (OIDC): the `id-token: write`
+# permission below lets GitHub mint a short-lived credential for this exact
+# repository, workflow and environment, so there is no API token in the
+# repository secrets to rotate or steal. Configure the publisher once at
+# https://pypi.org/manage/project/organizekit/settings/publishing/ with:
+#   owner smeltzzz · repository organize · workflow release.yml · environment pypi
+name: Release
+
+on:
+  push:
+    tags: ["v*"]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  verify:
+    name: The suite must pass before anything is built
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+      - run: python organize.py test
+      - run: python -m unittest discover -s tests -p "test_*.py"
+
+  build:
+    name: Build the wheel, the sdist and the zipapp
+    needs: verify
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+
+      - name: The tag must match organizekit.VERSION
+        # A tag that disagrees with the package is how 3.6.0 ends up on PyPI
+        # calling itself 3.5.0, which cannot be undone.
+        if: startsWith(github.ref, 'refs/tags/')
+        run: |
+          version=$(python -c "import organizekit; print(organizekit.VERSION)")
+          tag="${GITHUB_REF_NAME#v}"
+          test "$version" = "$tag" || { echo "tag $tag != VERSION $version"; exit 1; }
+
+      - run: python -m pip install --upgrade build twine
+      - run: python -m build
+      - name: The metadata must render on PyPI
+        run: python -m twine check dist/*
+
+      - name: The wheel must install and run from a clean environment
+        run: |
+          python -m venv /tmp/checkinstall
+          /tmp/checkinstall/bin/pip install dist/*.whl
+          cd /tmp && /tmp/checkinstall/bin/organize --version
+          cd /tmp && /tmp/checkinstall/bin/organize doctor --json > /dev/null
+
+      - name: The sdist must carry a suite that runs
+        # Not a formality: setuptools ships tests/test_*.py by default and
+        # leaves their fixtures behind, which yields a distribution whose tests
+        # cannot even be collected.
+        run: |
+          mkdir /tmp/sdist && tar xzf dist/*.tar.gz -C /tmp/sdist --strip-components=1
+          cd /tmp/sdist && python -m unittest discover -s tests -p "test_*.py"
+
+      - name: The zipapp ships with the release too
+        run: python scripts/build_pyz.py
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: release-artifacts
+          path: |
+            dist/*.whl
+            dist/*.tar.gz
+            dist/organize.pyz
+
+  publish:
+    name: Publish to PyPI
+    needs: build
+    runs-on: ubuntu-latest
+    if: startsWith(github.ref, 'refs/tags/')
+    environment:
+      name: pypi
+      url: https://pypi.org/p/organizekit
+    permissions:
+      id-token: write   # Trusted Publishing; no API token anywhere
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          name: release-artifacts
+          path: dist
+      - name: The zipapp is a GitHub asset, not a PyPI one
+        run: rm -f dist/organize.pyz
+      - uses: pypa/gh-action-pypi-publish@release/v1
+
+  github-release:
+    name: Attach the artifacts to the GitHub release
+    needs: publish
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          name: release-artifacts
+          path: dist
+      - uses: softprops/action-gh-release@v2
+        with:
+          files: dist/*
+          generate_release_notes: true
