# ==============================================================================
# Organize — Environment Configuration Template
# Copy this file to .env and configure for your environment
# ==============================================================================

# OpenSubtitles Consumer API Key (Free: https://www.opensubtitles.com/en/consumers)
OPENSUBTITLES_API_KEY=your_api_key_here

# Optional: OpenSubtitles user credentials (only needed for user auth mode)
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=

# Path overrides (default: Windows E:\torrents\...)
# MOVIE_STD_SOURCE=/mnt/storage/torrents/final
# MOVIE_STD_TARGET=/mnt/storage/torrents/final_organized
# MOVIE_STD_LOG=/mnt/storage/torrents/movie_standardizer/movie_standardizer.log
# MOVIE_STD_REPORT=/mnt/storage/torrents/movie_standardizer/movie_standardizer_report.txt

# Behavior overrides
# MOVIE_STD_MIN_SIZE=300
# MOVIE_STD_LOCK_TIMEOUT=60
# MOVIE_STD_DRY_RUN=false
