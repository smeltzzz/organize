# ==============================================================================
# Organize — Environment Configuration Template
#
# Copy this file to `.env` (or export the values in your shell profile /
# systemd EnvironmentFile) and adjust.
#
# Nothing here is required to *run* the toolkit — at least one subtitle-provider
# key is needed only for the subtitle step. Every path default lives in each
# tool and is overridable per run with CLI flags (see the README).
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenSubtitles (subtitle_fetcher.py)
# ------------------------------------------------------------------------------
# Free consumer API key: https://www.opensubtitles.com/en/consumers
OPENSUBTITLES_API_KEY=your_api_key_here

# Only needed when running with `--auth-mode user` (the default is the
# anonymous development mode, which uses the API key alone).
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=

# ------------------------------------------------------------------------------
# SubDL (subtitle_fetcher.py)
# ------------------------------------------------------------------------------
# Optional fallback/alternative provider. Get a key from:
# https://subdl.com/panel/api
# With both keys set, the fetcher keeps OpenSubtitles' exact moviehash lookup
# first, then consults SubDL only if no safe OpenSubtitles result is available.
# SubDL first uses its release-aware filename route and auto-selects only a
# provider score >= 0.80; strict title/year is used only when that route has no
# usable candidate. With only this key, the same conservative policy applies.
# SUBDL_API_KEY=

# ------------------------------------------------------------------------------
# Embedded subtitle extraction (subtitle_fetcher.py)
# ------------------------------------------------------------------------------
# Before downloading anything, the fetcher tries the movie's own embedded
# English subtitle track (needs MKVToolNix: mkvmerge + mkvextract on PATH).
# Image-based tracks (PGS/SUP, VobSub) additionally need one OCR backend:
# pgsrip (pip install pgsrip), sup2srt + Tesseract, Subtitle Edit, or
# PgsToSrt - auto-detected in that order, or point at your own tool with
# --ocr-backend custom.
#
# Where PgsToSrt's dll lives (it runs as `dotnet <dll>`):
# PGSTOSRT_DLL=/opt/PgsToSrt/PgsToSrt.dll
#
# Where the record of extracted sidecars lives. It must be OUTSIDE the media
# library; sync_subtitles.py reads it so an extracted sidecar (already
# frame-accurate) is never re-synced. Defaults to
# <folder holding the scripts>/ReportsAndLogs/subtitle_fetcher_extracted.json.
# SUBTITLE_EXTRACTED_LEDGER=/mnt/storage/organize_logs/subtitle_fetcher_extracted.json

# ------------------------------------------------------------------------------
# Paths (movie_standardizer.py, pipeline.py, jellyfin_one_shot.py)
# ------------------------------------------------------------------------------
# The defaults assume the documented Windows layout (E:\torrents\...).
# On Windows, logs/reports/probe caches default to
#   E:\torrents\tools\ReportsAndLogs\<tool>\...
# On Linux/macOS point these at your own folders. Requirements:
#   * SOURCE and TARGET must be on the SAME filesystem (hardlink-only ingest)
#   * logs/reports must live OUTSIDE the media library
# MOVIE_STD_SOURCE=/mnt/storage/torrents/final
# MOVIE_STD_TARGET=/mnt/storage/torrents/final_organized
#
# MOVIE_STD_TARGET is also the default movie-library root for pipeline.py and
# jellyfin_one_shot.py — set it once and a bare `jellyfin_one_shot.py` run
# finishes this library. An explicit --source / --target flag still wins.
# MOVIE_STD_LOG=/mnt/storage/organize_logs/movie_standardizer.log
# MOVIE_STD_REPORT=/mnt/storage/organize_logs/movie_standardizer_report.txt

# ------------------------------------------------------------------------------
# Behavior (movie_standardizer.py)
# ------------------------------------------------------------------------------
# Minimum size in MB for a file to be treated as a feature movie (default 300).
# MOVIE_STD_MIN_SIZE=300

# Seconds to wait for the cross-tool coordination lock (default 60).
# MOVIE_STD_LOCK_TIMEOUT=60

# Explicit ffprobe binary path, if it is not on PATH.
# MOVIE_STD_FFPROBE=/usr/bin/ffprobe

# Duplicate-folder maintenance: REPORT (default, non-destructive),
# QUARANTINE, or DELETE.
# MOVIE_STD_MAINTENANCE_MODE=REPORT
# MOVIE_STD_QUARANTINE=/mnt/storage/quarantine

# Optional JSON run manifest (automation-friendly), outside source and target.
# MOVIE_STD_MANIFEST=/mnt/storage/organize_logs/manifest.json

# Enable the duplicate-folder scan (equivalent of --deduplicate).
# MOVIE_STD_DEDUPLICATE=false

# Preview-only placement (equivalent of --dry-run).
# MOVIE_STD_DRY_RUN=false

# ------------------------------------------------------------------------------
# Subtitle sync (sync_subtitles.py)
# ------------------------------------------------------------------------------
# No environment variables are needed for this tool. It shells out to the
# ffsubsync program, which you install once on the machine (it must be on the
# PATH, together with ffmpeg, or the pipeline step is skipped with a reason):
#
#     pip install ffsubsync        # or: pipx install ffsubsync
#
# Useful per-run flags (defaults shown):
#   --max-offset 30   hold for review any sync demanding a shift beyond +/-30 s
#   --min-offset 0.1  treat drift below 0.1 s as "already in sync" (file untouched)
#   --dry-run         preview only; ffsubsync is never launched
#   --fail-on-review  exit 3 when any sidecar is held for review (schedulers)
