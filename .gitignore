# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
.env

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local runtime artifacts (these tools keep logs/reports outside the library,
# but keep anything that might land in the repo out of version control).
*.partial
*.partial.*
*.tmp
*.log
*_report.txt
*_probe_cache.json
*probe_cache*.json
transcript_*.err
# jellyfin_one_shot.py's default log dir (per-run logs + per-pass auditor reports)
logs/
# subtitle_fetcher.py's extraction record defaults to
# <dir holding the scripts>/ReportsAndLogs/subtitle_fetcher_extracted.json
ReportsAndLogs/

# Accidental desktop / OS dumps
Screenshot*.png
Screen Shot*.png
*.stackdump

