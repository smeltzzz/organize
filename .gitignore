# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
.env

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local runtime artifacts (these tools keep logs/reports outside the library,
# but keep anything that might land in the repo out of version control).
*.partial
*.partial.*
*.tmp
*.log
*_report.txt
*_probe_cache.json
*probe_cache*.json
transcript_*.err
# A stray per-run log directory (some deployments point --log / --report at one)
logs/
# subtitle_extractor.py's provenance ledger defaults to
# <dir holding the scripts>/ReportsAndLogs/subtitle_extractor_extracted.json
ReportsAndLogs/
# the shared state cache (a rebuildable derived cache, never authority)
state.db
state.db-wal
state.db-shm

# Accidental desktop / OS dumps
Screenshot*.png
Screen Shot*.png
*.stackdump

